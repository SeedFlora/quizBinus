# Keep the build context small and free of secrets. Everything the image needs is
# source, package manifests and drizzle/ (SQL migrations); dependencies are installed
# inside the build.

# Dependencies and build output (rebuilt inside the image; host binaries may be Windows/macOS)
node_modules
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Secrets: only the documented example may enter the context
.env
.env.*
!.env.example

# Runtime data on the host (uploads, database dumps): never baked into an image
data
backups
*.dump
*.sql.gz

# VCS, CI and editor metadata
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.editorconfig
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Docker and ops files (changing them should not bust the COPY . . layer)
Dockerfile
.dockerignore
docker-compose*.yml
compose*.yml
deploy

# Tests, tooling output and local review artefacts (not needed to build or run)
coverage
playwright-report
test-results
blob-report
playwright/.cache
.playwright-mcp
.shots
tests
e2e

# Documentation (the running app never reads it)
docs
*.md
