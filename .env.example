# ------------------------------------------------------------------------------------------
# NUSAQUEST environment (self-hosted: Docker on Proxmox or any Linux host; no cloud services)
#
#   docker compose:   cp .env.example .env         then fill in the "Required" block
#   npm run dev:      cp .env.example .env.local   (every variable is optional there)
#
# With NOTHING set, `npm run dev` runs in MEMORY MODE: the game server still runs in the
# Next.js process (real multi-device play on your LAN), but there is no login, quizzes live
# in the browser, and nothing survives a restart. Set DATABASE_URL for DATABASE MODE:
# lecturer accounts, quizzes, reports and session recovery in PostgreSQL.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time (`next build`,
# `docker compose build`). Changing one requires a rebuild. Never put a secret in one.
#
# Secrets: this file is the only .env* file tracked by git. Keep the real .env readable by
# the deploy user only (chmod 600 .env). Generate strong values, e.g.
#   openssl rand -hex 24          # database password (hex = safe inside a URL)
#   openssl rand -base64 18       # admin password (or a 4+ word passphrase)
# ------------------------------------------------------------------------------------------

# === Required for docker compose ==========================================================

# PostgreSQL credentials for the bundled `db` service. Compose builds the app's DATABASE_URL
# from these (postgres://USER:PASSWORD@db:5432/DB). Use letters and digits only (e.g. the
# hex output above): the password is embedded in a URL. Changing it later requires
# changing it inside Postgres too (ALTER USER), because the data volume keeps the old one.
POSTGRES_USER=nusaquest
POSTGRES_PASSWORD=
POSTGRES_DB=nusaquest

# First administrator, created on start-up ONLY while the users table is empty (it also
# receives the five demo quizzes). Sign in at /login, then add lecturers in Settings →
# Lecturer accounts (or `bash deploy/users.sh`, docs/DEPLOYMENT.md §5). The server enforces at least 8
# characters; use 12+ or a passphrase, and never a campus (SSO) password. Once the admin
# exists this value is never read again (changing it does NOT change the password), so
# you may delete it from this file after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Display name of that admin, e.g. "Dr. Rina Wijaya".
ADMIN_NAME=

# Public origin of this server, without trailing slash. Used for absolute links and shown
# to hosts as the join address. Must be reachable from students' phones:
#   https://quiz.example.ac.id        (behind HTTPS / a reverse proxy)
#   http://10.20.30.40:3000           (plain HTTP on the campus LAN)
APP_URL=

# === Database (outside docker compose) ====================================================

# Connection string for `npm run dev`, a bare-Node install (docs/DEPLOYMENT.md §13) or a
# container run without compose.
# Empty = memory mode. Compose ignores this value (it always points the app at its `db`).
#   npm run db:up  → postgres://nusaquest:<POSTGRES_PASSWORD>@localhost:5432/nusaquest
DATABASE_URL=

# Integration tests (Vitest) that need PostgreSQL run only when this is set; use a
# THROWAWAY database, tests create and drop their own schemas.
#   docker run -d --name nq-test-pg -e POSTGRES_USER=nq -e POSTGRES_PASSWORD=nq \
#     -e POSTGRES_DB=nusaquest_test -p 55432:5432 postgres:17-alpine
# TEST_DATABASE_URL=postgres://nq:nq@localhost:55432/nusaquest_test

# === Server runtime (optional) ============================================================

# Directory for uploaded question images. The Docker image uses /app/data/uploads (a
# volume); for `npm run dev` the default is ./data/uploads (git-ignored).
# UPLOAD_DIR=./data/uploads

# Secure flag of the lecturer session cookie (nq_session):
#   auto   Secure when the request arrived over HTTPS (X-Forwarded-Proto from the proxy)
#   true   always Secure (HTTPS-only deployments)
#   false  never Secure (plain-HTTP LAN; the cookie is still HttpOnly + SameSite=Lax)
SESSION_COOKIE_SECURE=auto

# Set to true ONLY when a reverse proxy you control (Caddy profile, nginx, Nginx Proxy
# Manager, Traefik) sits in front of the app and overwrites X-Forwarded-For / X-Real-IP.
# Join and answer rate limits key on the client IP; with false, forwarded headers from
# clients are not trusted.
TRUST_PROXY=false

# Time zone for server logs, backup timestamps and server-rendered dates.
TZ=Asia/Jakarta

# === Browser (build time, NEXT_PUBLIC_*) ===================================================

# Origin encoded in lobby QR codes and join links. Usually the same as APP_URL. Empty =
# the origin the host screen is opened on (fine when the projector laptop opens the
# server by its LAN address; the lobby also lists LAN addresses when opened on localhost).
NEXT_PUBLIC_APP_URL=

# Realtime transport:
#   server  multi-device play through this server (default; classrooms, production)
#   local   in-browser solo demo only (one browser, BroadcastChannel; offline showcases)
NEXT_PUBLIC_REALTIME_MODE=server

# Path or URL of the official BINUS logo. Put the file in public/brand/ and reference it as
# /brand/<file>. Empty = neutral typographic placeholder (no institutional asset is bundled
# in this repository). See README → Branding.
NEXT_PUBLIC_BINUS_LOGO_SRC=

# === docker compose options ================================================================

# Host port for the app (the container always listens on 3000). Use 127.0.0.1:3000 when a
# reverse proxy on the same host is the only way in.
# APP_PORT=3000

# Domain served by the Caddy HTTPS profile (docker compose --profile https up -d).
# Public DNS name → Let's Encrypt certificate (ports 80/443 reachable from the internet).
# DOMAIN=quiz.example.ac.id

# Backup profile (docker compose --profile backup up -d): interval, retention and target.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups

# Profiles started by every plain `docker compose up`, so --profile is no longer needed.
# https needs DOMAIN (above); backup needs the backups folder created first (docs/DEPLOYMENT.md §8).
# COMPOSE_PROFILES=https,backup

# Loopback port of PostgreSQL for the development overlay (npm run db:up).
# DB_PORT=5432

# Image tag for the app service, and the version string reported by GET /api/health
# (e.g. the git SHA: APP_VERSION=$(git rev-parse --short HEAD) docker compose build).
# APP_IMAGE_TAG=local
# APP_VERSION=
